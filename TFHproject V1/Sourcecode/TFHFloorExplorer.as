package{	import flash.display.*;	import flash.events.*;	import flash.text.*;	import flash.ui.*;		import org.papervision3d.cameras.*;	import org.papervision3d.core.*;	import org.papervision3d.materials.*;	import org.papervision3d.objects.*;	import org.papervision3d.scenes.*;	/**	 * A TFHFloorExplorer is used to explore the floors of one of the four	 * TFH buildings (Gauss, Grashof, Beuth, Bauwesen).	 *	 */	public class TFHFloorExplorer extends Sprite	{		/**		 * Exploring state.		 * The explorer is in exploring state when a floor is loaded and the		 * user can move across the floor.		 */		public static const STATE_EXPLORING = 1;		/**		 * Moving-down state.		 * The explorer is in moving-down state when we're currently in a 		 * transition to a lower floor. While this is happening the user		 * cant do anything.		 */		public static const STATE_MOVING_DOWN = 2;		/**		 * Moving-up state.		 * The explorer is in moving-up state when we're currently in a		 * transition to a higher floor. While this is happening the user		 * cant do anything.		 */		public static const STATE_MOVING_UP = 3;				var container 	 :Sprite;		var scene     	 :Scene3D;		var camera    	 :TFHCamera;		var mouseButtonPressed :Boolean;		var mousePosX 	 :Number;		var mousePosY 	 :Number;		var backbtn:	MovieClip;				/**		 * The name of the current building that is explored.		 */		private var _activeBuilding :String;		/**		 * The currently active floor.		 */		private var activeFloor :TFHFloor;		/**		 * The currently active level.		 */		private var _currentLevel :Number = 1;		/**		 * Lookup map for all floor models of all TFH buildings.		 */		private var _floorMap :Object = {			 	gauss:    {1:"Gauss/Floors/1.dae", 2:"Gauss/Floors/1.dae", 3:"Gauss/Floors/1.dae", 4:"Gauss/Floors/1.dae"},				bauwesen: {1:"Gauss/Floors/1.dae", 2:"Gauss/Floors/1.dae", 3:"Gauss/Floors/1.dae", 4:"Gauss/Floors/1.dae"},				grashof:  {1:"Gauss/Floors/1.dae", 2:"Gauss/Floors/1.dae", 3:"Gauss/Floors/1.dae", 4:"Gauss/Floors/1.dae"},				beuth:    {1:"Gauss/Floors/1.dae", 2:"Gauss/Floors/1.dae", 3:"Gauss/Floors/1.dae", 4:"Gauss/Floors/1.dae"}		};				private var _roomMap :Object = {			 	gauss:    {200:[2600,0,-50],   201:[50,250,-50],   202:[400,250,-50],   203:[350,-230,-50],						   204:[750,-230,-50], 205:[-50,-230,-50], 206:[-450,-230,-50], 207:[-1250,-230,-50],						   208:[-1700,-230,-50]},				bauwesen: {},				grashof:  {}		};				/**		 * The label used to display the floor number/level.		 */		private var _floorNumberLabel:TextField;				/**		 * Tracks the number of animation steps when moving between floors.		 */		private var _moveStep = 0;				/**		 * The current state of the explorer object.		 */		private var _state :Number = STATE_EXPLORING;				/**		 * A pointer used to point to a specific room.		 */		private var _roomPointer :Sphere;		/** 		 * Constructs a new floor explorer.		 *		 * @param Sprite  The parent sprite in the display hierarchy.		 * @param String  The name of the building to explore.		 */		public function TFHFloorExplorer(parentSprite:Sprite, building:String)		{			//stage.scaleMode = StageScaleMode.EXACT_FIT;						container = new Sprite();			addChild(container);						container.x = parentSprite.root.width  / 2;			container.y = parentSprite.root.height / 2;					scene  = new Scene3D(container);			camera = new TFHCamera(900);			camera.y += 900;						_activeBuilding = building;			_initFloorNumberLabel();			_createInfoPanel();			// room pointer			var sphereColor:ColorMaterial = new ColorMaterial(0xff0000);			_roomPointer = new Sphere(sphereColor, 50);			// Make the first floor the active floor			this._loadFloor();			// Eventhandling			parentSprite.addEventListener(Event.ENTER_FRAME      , loop3D);			parentSprite.stage.addEventListener(MouseEvent.MOUSE_DOWN , mouseDown);			parentSprite.stage.addEventListener(MouseEvent.MOUSE_MOVE , mouseMove);			parentSprite.stage.addEventListener(MouseEvent.MOUSE_UP   , mouseUp);			parentSprite.stage.addEventListener(KeyboardEvent.KEY_DOWN, keyPress);						backbtn = new BackButton();			backbtn.x = 600;			backbtn.y = 360;			backbtn.addEventListener( MouseEvent.CLICK , back );			this.addChild(backbtn);		}				public function back(event:Event): void {			TFHCommunicationLibary.switchScene = TFHCommunicationLibary.SCENE1;		}				public function pointToRoom(roomNumber:Number) {			var pos:Object = _roomMap[_activeBuilding][roomNumber];			scene.removeChild(_roomPointer);			_roomPointer.x = pos[0];			_roomPointer.y = pos[1];			_roomPointer.z = pos[2];			scene.addChild(_roomPointer);		}				/**		 * Initiates the information panel for the current building		 * and places it on the scene.		 */		private function _createInfoPanel() {			var infoPanel:DisplayObject = null;			if (_activeBuilding == "gauss") {				infoPanel = new GaussInfoPanel();			} else if (_activeBuilding == "grashof") {				infoPanel = new GaussInfoPanel();			} else {				throw new Error("No info panel found for building " + _activeBuilding);							}			infoPanel.x = 148;			infoPanel.y = 385;			addChild(infoPanel);		}		/**		 * Initializes the floor number label and adds it to the stage.		 */		private function _initFloorNumberLabel() {			_floorNumberLabel = new TextField();			_floorNumberLabel.autoSize = TextFieldAutoSize.LEFT;            _floorNumberLabel.background = false;            _floorNumberLabel.border = false;            var format:TextFormat = new TextFormat();            format.font = "Verdana";            format.color = 0xFFFFFF;            format.size = 14;            format.underline = false;			format.bold = true;            _floorNumberLabel.defaultTextFormat = format;			_floorNumberLabel.text = "Haus " + _activeBuilding + " - Etage " + this._currentLevel;			_floorNumberLabel.x = 5;			_floorNumberLabel.y = 370;            addChild(_floorNumberLabel);		}				/*		private function _initNavigationLabel() {			var _helpLabel = new TextField();			_helpLabel.autoSize = TextFieldAutoSize.LEFT;            _helpLabel.background = false;            _helpLabel.border = false;            var format:TextFormat = new TextFormat();            format.font = "Verdana";            format.color = 0xFFFFFF;            format.size = 14;            format.underline = false;			format.bold = true;            _helpLabel.defaultTextFormat = format;			_helpLabel.text = "Hoch/Runter";			_helpLabel.x = 50;			_helpLabel.y = 200;            addChild(_helpLabel);		}		*/				/**		 * Renders the scene. Called by onEnterFrame events.		 */		function loop3D(event:Event):void {			if (this._state == STATE_MOVING_DOWN) {				if (this._moveStep == 15) {					this._state = STATE_EXPLORING;					this._currentLevel--;					this._moveStep = 0;					this._loadFloor();				} else {					this.activeFloor.moveUp(70);					this._moveStep++;				}			} else if (this._state == STATE_MOVING_UP) {				if (this._moveStep == 15) {					this._state = STATE_EXPLORING;					this._currentLevel++;					this._moveStep = 0;					this._loadFloor();				} else {					this.activeFloor.moveDown(400);					this._moveStep++;				}			}			scene.renderCamera(camera);		}				/**		 * Handles mouseDown events.		 */		function mouseDown(event:MouseEvent):void {			mousePosX = mouseX;			mousePosY = mouseY;			mouseButtonPressed = true;		}				/**		 * Handles mouseMove events.		 */		function mouseMove(event:Event):void {			if (mouseButtonPressed) {				//Um den Centerpunkt drehen...				//camera.surroundXZ( (mousePosX - mouseX) / 2 );				camera.x += 4 * (mousePosX - mouseX) / 2;				mousePosX = mouseX;								// In der Tiefe bewegen...				//camera.moveDepth( (mousePosY - mouseY) * 10 );				camera.y -= 4 * (mousePosY - mouseY) / 2;				mousePosY = mouseY;			}		}				/**		 * Handles mouseUp events (button released).		 */		function mouseUp(event:Event):void {			mouseButtonPressed = false;		}				/**		 * Loads a floor into the scene. Which floor is loaded depends on the _activeBuilding		 * and _currentLevel properties.		 */		private function _loadFloor() {			this.scene.removeChild(this.activeFloor);			this.activeFloor = new TFHFloor(this._floorMap[this._activeBuilding][this._currentLevel], 0.2);			this.activeFloor.rotationX = 90;			//this.activeFloor.yaw(10);			this._floorNumberLabel.text = "Haus " + this._activeBuilding + " - Etage " + this._currentLevel;			this.scene.addChild(this.activeFloor);		}				/**		 * Handles keyPress events.		 */		function keyPress(event:KeyboardEvent): void {			//Höhe bewegen:			if (event.keyCode == Keyboard.DOWN && this._state == STATE_EXPLORING) {				if (_floorMap[this._activeBuilding][this._currentLevel + 1]) {					this.scene.removeChild(_roomPointer);					this._state = STATE_MOVING_UP;				}			} else if (event.keyCode == Keyboard.UP && this._state == STATE_EXPLORING) {				if (_floorMap[this._activeBuilding][this._currentLevel - 1]) {					this.scene.removeChild(_roomPointer);					this._state = STATE_MOVING_DOWN;				}			}						//Links & Rechts drehen:			if (event.keyCode == Keyboard.LEFT) {				camera.x -= 20;			}			if (event.keyCode == Keyboard.RIGHT) {				camera.x += 20;			}						//Reset Camera: camera.resetCamera();			trace("Tastennummer:"+ event.keyCode );		}	}}