package{	import flash.display.Loader;	import flash.display.MovieClip;	import flash.display.Sprite;	import flash.events.Event;	import flash.events.ProgressEvent;	import flash.net.URLRequest;	import flash.text.TextField;	import flash.text.TextFieldAutoSize;	import flash.text.TextFormat;		import org.papervision3d.cameras.*;	import org.papervision3d.core.*;	import org.papervision3d.materials.*;	import org.papervision3d.objects.*;	import org.papervision3d.scenes.*;		public class TFHindex extends Sprite	{		 		var loader:      Loader;		var urlRequest:  URLRequest;		var textfield:   TextField;		var textformat:  TextFormat;		var preloadclip: MovieClip   = new Preloader();				var i:Number = 0;				public function TFHindex() {			this.addEventListener( Event.ADDED_TO_STAGE , init );		}				function init(event:Event): void {			this.addEventListener( Event.ENTER_FRAME , switchScene );			this.loader     = new Loader();			this.loader.contentLoaderInfo.addEventListener(ProgressEvent.PROGRESS, onLoading  );			this.loader.contentLoaderInfo.addEventListener(Event.COMPLETE,         onFinishing);						this.load(TFHCommunicationLibary.SCENE1);									//Preloader Animation			this.preloadclip.x       = this.width / 2;			this.preloadclip.y       = this.height / 2;			this.addChild(this.preloadclip);						//Textfeld			this.textformat   		  = new TextFormat();			this.textformat.color     = 0xFFFFFF;			this.textformat.font      = "Arial";			this.textformat.size 	  = 11;						this.textfield            = new TextField();			this.textfield.autoSize   = TextFieldAutoSize.CENTER;			this.textfield.x          = this.width / 2;			this.textfield.y          = this.preloadclip.y + this.preloadclip.height;			this.textfield.selectable = false;			this.textfield.text       = "Wird geladen";			this.textfield.alpha      = 0.25;						this.textfield.setTextFormat(textformat);			this.addChild(this.textfield);		}				function load(path:String): void {			this.urlRequest = new URLRequest(path);			this.loader.load(urlRequest);		}				function onLoading(event:ProgressEvent): void {			this.textfield.text = "Wird geladen... "+ Math.round(event.bytesLoaded * 100 / event.bytesTotal) +"%";			this.textfield.setTextFormat(this.textformat);		}				function onFinishing(event:Event): void {			trace("Szene fertig geladen & wird jetzt eingebunden...");			this.removeChild( this.preloadclip );			this.removeChild( this.textfield );			this.addChild( this.loader );		}		function switchScene(event:Event): void {			//trace("prüfe ob gewechselt werden soll...");			if( TFHCommunicationLibary.switchScene != TFHCommunicationLibary.NOSCENESWITCH ) {				trace("lade neue Szene ("+ TFHCommunicationLibary.switchScene +")");				this.removeChild( this.loader );								this.addChild(this.preloadclip);				this.addChild(this.textfield);								this.load(TFHCommunicationLibary.switchScene);								TFHCommunicationLibary.switchScene = TFHCommunicationLibary.NOSCENESWITCH;			}		}	}}