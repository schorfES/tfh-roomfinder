package{	import flash.display.*;	import flash.events.*;		import org.papervision3d.cameras.*;	import org.papervision3d.core.*;	import org.papervision3d.materials.*;	import org.papervision3d.objects.*;	import org.papervision3d.scenes.*;	public class TFH extends Sprite	{		var container 	 :Sprite;		var scene     	 :Scene3D;		var camera    	 :TFHCamera;		var cameraMoving :TFHCameraMoving;		var logo         :MovieClip;		var popupMenu    :MovieClip;		var mainMenu     :MovieClip;		var changeMouse  :Boolean;		var mousePosX 	 :Number;		var mousePosY 	 :Number;		function TFH()		{			this.addEventListener( Event.ADDED_TO_STAGE , init );		}				function init(event:Event): void {						// Dient dazu, dass die Ausrichtung im Browser dann zentriert ist:			stage.align = StageAlign.LEFT;						// Initialisierung:			// Erzeuge einen Container und zentriere ihn in der Mitte der Bühne:			// ----------------------------------------------------------			container = new Sprite();			this.addChild( container );			//container.x = root.width  / 2;			//container.y = root.height / 2;			container.x = stage.stageWidth / 2;			container.y = stage.stageHeight / 2;					// Erzeuge die Szene und Kamera------------------------------			scene  = new Scene3D( container );			camera = new TFHCamera(900);			camera.start();									// Erzeugen des Cameramoving-Objekts-------------------------			cameraMoving = new TFHCameraMoving(camera,this);			// Einfügen der Objekte--------------------------------------			//addHouseGauss(0.15,-9000,0,1000);			//Informatikhaus			//addHouseBeuth(0.7,-5000,-80,6000);					//Mathehaus			//addHouseGrashof(0.7,-5000,-80,2500);		//Hochhaus			//addHouseBauwesen(0.15,700,0,900);			addHouseScenery(0.5,0,0,0);						// Einfügen der Menüs (Movieclips)---------------------------			//addInfopanel();			//addLogo();			addMainmenu();								// Eventhandling---------------------------------------------			this.addEventListener( Event.ENTER_FRAME      , loop3D     );			this.addAllStageEvents();						root.addEventListener( "TFHActionEvent", mainMenuAction );		}		// Menüs---------------------------------------------------------		function addInfopanel(): void {			var infopanel:MovieClip = new Infopanelmovie();			infopanel.x = 150;			infopanel.y = 42;			addChild(infopanel);		}		function addMainmenu(): void {			this.mainMenu = new MainmenuV3();			this.mainMenu.x = this.stage.stageWidth/2;			this.mainMenu.y = 0;			addChild(this.mainMenu);			}		function addPopupmenu(): void {			this.popupMenu   = new PopupMenu();			this.popupMenu.x = this.stage.stageWidth / 2;			this.popupMenu.y = this.stage.stageHeight / 2;			addChild(this.popupMenu);		}		function addLogo() {			this.logo   = new TFHroomFinderLogo();			this.logo.x = 10;			this.logo.y = 380;			addChild(this.logo);		}		// Häuser--------------------------------------------------------		function addHouseGauss(size,x,y,z :Number): void {			var haus   :Collada = new Collada("../Buildings/Gauss/HausGaussHighPoly.DAE", null,  size );			haus.x = x;			haus.y = y;			haus.z = z;			scene.addChild( haus );		}		function addHouseBauwesen(size,x,y,z :Number): void {			var haus   :Collada = new Collada("../Buildings/Bauwesen/Bauwesen.DAE", null,  size );			haus.x = x;			haus.y = y;			haus.z = z;			scene.addChild( haus );		}		function addHouseBeuth(size,x,y,z :Number): void {			var haus   :Collada = new Collada("../Buildings/Beuth/beuth1.5.dae", null,  size );			haus.x = x;			haus.y = y;			haus.z = z;			scene.addChild( haus );		}		function addHouseGrashof(size,x,y,z :Number): void {			var haus   :Collada = new Collada("../Buildings/Grashof/grashof1.5.dae", null,  size );			haus.x = x;			haus.y = y;			haus.z = z;			scene.addChild( haus );		}		function addHouseScenery(size,x,y,z :Number): void {			var haus   :Collada = new Collada("../Buildings/allInOne/allHouses1.1.dae", null,  size );			haus.x = x;			haus.y = y;			haus.z = z;			scene.addChild( haus );		}				// Events--------------------------------------------------------		public function addAllStageEvents(): void {			stage.addEventListener( MouseEvent.MOUSE_DOWN , mouseDown  );			stage.addEventListener( MouseEvent.MOUSE_MOVE , mouseMove  );			stage.addEventListener( MouseEvent.MOUSE_UP   , mouseUp    );			stage.addEventListener( MouseEvent.MOUSE_WHEEL, mouseWheel );			stage.addEventListener( KeyboardEvent.KEY_DOWN, keyPress   );		}				public function removeAllStageEvents(): void {			stage.removeEventListener( MouseEvent.MOUSE_DOWN , mouseDown  );			stage.removeEventListener( MouseEvent.MOUSE_MOVE , mouseMove  );			stage.removeEventListener( MouseEvent.MOUSE_UP   , mouseUp    );			stage.removeEventListener( MouseEvent.MOUSE_WHEEL, mouseWheel );			stage.removeEventListener( KeyboardEvent.KEY_DOWN, keyPress   );		}				public function loop3D(event:Event):void {						//this.stage.align = StageAlign.RIGHT;						cameraMoving.move();			scene.renderCamera( camera );		}		public function mouseDown(event:MouseEvent):void {			mousePosX = mouseX;			mousePosY = mouseY;			changeMouse = true;		}		public function mouseMove(event:Event):void {			if(changeMouse) 			{				//Um den Centerpunkt drehen...				camera.surroundXZ( (mousePosX - mouseX) / 2 );				mousePosX = mouseX;								// In der Tiefe bewegen...				camera.moveDepth( (mousePosY - mouseY) * 10 );				mousePosY = mouseY;			}		}		public function mouseUp(event:Event):void {			changeMouse = false;		}				public function mouseWheel(event:MouseEvent): void {			trace("Mousewheel Event");		}		public function keyPress(event:KeyboardEvent): void {						//Tiefe bewegen:			//if( event.keyCode == 38 ) { camera.moveDepth( -50 ); }  //rein			//if( event.keyCode == 40 ) { camera.moveDepth(  50 ); }  //raus						//Höhe bewegen:			if( event.keyCode == 38 ) { camera.moveHeight(  25 ); }  //hoch			if( event.keyCode == 40 ) { camera.moveHeight( -25 ); }  //runter						//Oben & Unten drehen:			//if( event.keyCode == 38 ) { camera.surroundXY(  3 ); }  //hoch			//if( event.keyCode == 40 ) { camera.surroundXY( -3 ); }  //runter						//Links & Rechts drehen:			if( event.keyCode == 37 ) { camera.surroundXZ( -3 ); }  //links			if( event.keyCode == 39 ) { camera.surroundXZ(  3 ); }  //rechts						//Reset Camera: camera.resetCamera();						//WASD			if( event.keyCode == 87 ) { camera.surroundXY(  3 ); }; // W			if( event.keyCode == 83 ) { camera.surroundXY( -3 ); }; // S			if( event.keyCode == 65 ) { camera.surroundXZ(  3 ); }; // A			if( event.keyCode == 68 ) { camera.surroundXZ( -3 ); }; // D						if( event.keyCode == 73 ) {								// i					trace("  x: "     + camera.getXPos() + 						  ", y: "     + camera.getYPos() + 						  ", z: "     + camera.getZPos() + 						  ", Winkel: "+ camera.getYaw() +"°"); 			}										trace("Tastennummer:"+ event.keyCode );		}		public function mainMenuAction(event:Event): void {			trace("Menüevent Empfangen... Fliege Zu Raum:"+ TFHCommunicationLibary.roomNumber);			var x:   Number = TFHCommunicationLibary.externPointX;			var y:   Number = TFHCommunicationLibary.externPointY;			var z:   Number = TFHCommunicationLibary.externPointZ;			var yaw: Number = TFHCommunicationLibary.externPointYaw;						var newPoint = new TFHPoint3D(x, y, z, yaw, 0);				  			this.cameraMoving.stop();			this.cameraMoving.setPoint(newPoint);			this.cameraMoving.play();				  		}	}}