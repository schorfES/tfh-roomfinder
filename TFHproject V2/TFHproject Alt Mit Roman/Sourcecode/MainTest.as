package{	import flash.display.*;	import flash.events.*;	import flash.text.*;	import flash.ui.*;		import org.papervision3d.cameras.*;	import org.papervision3d.core.*;	import org.papervision3d.materials.*;	import org.papervision3d.objects.*;	import org.papervision3d.scenes.*;	public class MainTest extends Sprite	{				private var _floorExplorer:TFHFloorExplorer;				public function MainTest()		{			this.addEventListener( Event.ADDED_TO_STAGE , init );		}				public function init(event:Event) {			trace("Lade haus:"+ TFHCommunicationLibary.houseName +"/"+ TFHCommunicationLibary.roomNumber);			_floorExplorer = new TFHFloorExplorer(this, "gauss");			addChild(_floorExplorer);			stage.addEventListener(KeyboardEvent.KEY_DOWN, keyPress);			//_floorExplorer.pointToRoom(202);		}				private function keyPress(event:KeyboardEvent) : void {		    if (event.keyCode == Keyboard.SPACE) {				trace("dddd");				_floorExplorer.pointToRoom(208);			}			//_floorExplorer.pointToRoom(201);		}	}}