package
{
import flash.display.*;
import flash.geom.*;
import flash.text.*;
import flash.events.*;

class TFHmenu extends Sprite
{
	var scene:Stage;
	
	var inputHandler:TFHinputManager;
	var searchInput:TextField;
	var rightFormat:TextFormat;
	var goBtn:Button3DBlue;
	
	function TFHmenu( sizeX:uint, sizeY:uint, posX:int, posY, handler:TFHinputManager )
	{
		trace( " <<< size: "+sizeX+" : "+sizeY+" >>>\n <<< manager: "+handler );
		inputHandler = handler;
		
		var matr:Matrix = new Matrix();
  		matr.createGradientBox( sizeX, sizeY, 0.5*Math.PI, 00,00 );
		
		var bg:Shape = new Shape();
		bg.graphics.beginGradientFill( GradientType.LINEAR, 
										 [0x787878, 0xFFFFFF], 
										 [1, 1], 
										 [0x00, 0xFF], matr, 
										 SpreadMethod.PAD );
		bg.graphics.lineStyle( 0,0x000000, 0.4 );
		bg.graphics.drawRoundRect( 0,0, sizeX, sizeY, sizeY*0.1, sizeY*0.1 );
		bg.graphics.endFill();
		addChild( bg );
		
		var gloss:Shape = new Shape();
		gloss.graphics.beginGradientFill( GradientType.LINEAR, 
										 [0xFFFFFF, 0xFFFFFF], 
										 [0.4, 0], 
										 [0x00, 0xFF], matr, 
										 SpreadMethod.PAD );
		gloss.graphics.lineStyle( 0,0x000000, 0 );
		gloss.graphics.drawRoundRect( 2,2, sizeX-4, sizeY-4, sizeY*0.1, sizeY*0.1 );
		gloss.graphics.endFill();
		addChild( gloss );
		
		goBtn = new Button3DBlue();
		goBtn.scaleX = 0.45;
		goBtn.scaleY = 0.45;
		goBtn.x += 0.95*sizeX;
		goBtn.y += height*0.45;
		goBtn.tabEnabled = false;
		addChild( goBtn );
		
		var inputBg:myTextInput = new myTextInput();
		inputBg.txtField.maxChars = 4;
		inputBg.scaleX = 1.5;
		inputBg.scaleY = 1.5;
		inputBg.x = goBtn.x-inputBg.width-50;
		inputBg.y = (height-inputBg.height*0.5)*0.5;
		addChild( inputBg );
		
		searchInput = inputBg.txtField;
		searchInput.text = "D100";
		rightFormat = searchInput.getTextFormat();
		
		var controls:ControlsLabel2 = new ControlsLabel2();
		controls.x = 0.01*inputHandler.stage.stageWidth;
		controls.y = height*0.4;
		addChild( controls )
		
		this.y += inputHandler.stage.stageHeight - sizeY;
		
//		activateMenu();
		trace( " =>-<= MenuInited" );
	}
	
	function goBtnClicked( event:MouseEvent ) :void
	{
		trace( "goBtnClicked: "+event );
		inputHandler.processMenuRequest( parseToHouse( searchInput.text ),
								  		 parseToFloor( searchInput.text ),
								  	     parseToRoom(  searchInput.text ) );
		deactivateMenu();
	}
	function inputKeyUp( event:KeyboardEvent ) :void
	{
		if( event.charCode == 13 ) // return
		{
			inputHandler.processMenuRequest( parseToHouse( searchInput.text ),
											 parseToFloor( searchInput.text ),
											 parseToRoom(  searchInput.text ) );
			deactivateMenu();
		}


		trace( "charCode : "+event.charCode );
	}
	function textInput( event:Event ) :void
	{
		trace( "event name: "+event.type );
//		searchInput.setTextFormat( rightFormat );
	}
	
	function activateMenu() :void
	{
		goBtn.addEventListener( MouseEvent.CLICK, goBtnClicked );
		searchInput.addEventListener( TextEvent.TEXT_INPUT, textInput );
		searchInput.addEventListener( KeyboardEvent.KEY_UP, inputKeyUp );
		searchInput.selectable = true;
	}
	function deactivateMenu() :void
	{
		goBtn.removeEventListener( MouseEvent.CLICK, goBtnClicked );
		searchInput.removeEventListener( KeyboardEvent.KEY_UP, inputKeyUp );
		searchInput.selectable = false;
		searchInput.setTextFormat( rightFormat );
	}
	
	function parseToHouse( userInput:String ) :String
	{
		trace( "parsedHouse: "+userInput.charAt(0) );
		switch( userInput.charAt(0).toUpperCase() )
		{
			case 'D' : return "grashof";
			case 'A' : return "beuth";
			case 'B' : return "gauss";
			case 'C' : return "bauwesen";
			default  : return "ERROR no valid houseLetter :: "+userInput.charAt(0);
		}
	}
	function parseToFloor( userInput:String ) :int
	{
		trace( "parsedFloor: "+userInput.charAt(1) );
		switch( userInput.charAt(1) )
		{
			case '0' : return 1;
			case '1' : return 2;
			case '2' : return 3;
			case '3' : return 4;
			case '4' : return 5;
			case '5' : return 6;
			case '6' : return 7;
			case '7' : return 8;
			case '8' : return 9;
			case '9' : return 10;
			case '10' : return 11;
			default  : return -1;
		}
	}
	function parseToRoom( userInput:String ) :String
	{
		trace( "parsedRoom: "+userInput.substring( 1,4 ) );
		return userInput.substring( 1,4 );
	}
}
}