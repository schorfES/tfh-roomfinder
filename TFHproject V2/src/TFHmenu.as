package{import flash.display.*;import flash.geom.*;import flash.text.*;import flash.events.*;class TFHmenu extends Sprite{	var scene:Stage;		var inputHandler:TFHinputManager;	var searchInput:TextField;	var rightFormat:TextFormat;	var goBtn:ButtonV3;		function TFHmenu( sizeX:uint, sizeY:uint, posX:int, posY, handler:TFHinputManager )	{		trace( " <<< size: "+sizeX+" : "+sizeY+" >>>\n <<< manager: "+handler );		inputHandler = handler;				var menu:MovieClip = new MainMenu();		menu.x = sizeX - menu.width;		menu.y = sizeY - menu.height;		addChild(menu);				searchInput      = menu.textinput.txtField;		searchInput.text = "D100";		rightFormat      = searchInput.getTextFormat();		goBtn            = menu.textinput.goBtn;						var logo:MovieClip = new TFHroomFinderLogo();		logo.y = menu.y - logo.height;		logo.x = menu.x + 20;		addChild(logo);				var button:MovieClip = new Keyboardinfo();		button.x = logo.x - 73;		button.y = logo.y + 18;		addChild( button );						this.y += inputHandler.stage.stageHeight - sizeY;						//		activateMenu();		trace( " =>-<= MenuInited" );	}		function goBtnClicked( event:MouseEvent ) :void	{		trace( "goBtnClicked: "+event );		inputHandler.processMenuRequest( parseToHouse( searchInput.text ),								  		 parseToFloor( searchInput.text ),								  	     parseToRoom(  searchInput.text ) );		deactivateMenu();	}	function inputKeyUp( event:KeyboardEvent ) :void	{		if( event.charCode == 13 ) // return		{			inputHandler.processMenuRequest( parseToHouse( searchInput.text ),											 parseToFloor( searchInput.text ),											 parseToRoom(  searchInput.text ) );			deactivateMenu();		}		trace( "charCode : "+event.charCode );	}	function textInput( event:Event ) :void	{		trace( "event name: "+event.type );//		searchInput.setTextFormat( rightFormat );	}		function activateMenu() :void	{		goBtn.addEventListener( MouseEvent.CLICK, goBtnClicked );		searchInput.addEventListener( TextEvent.TEXT_INPUT, textInput );		searchInput.addEventListener( KeyboardEvent.KEY_UP, inputKeyUp );		searchInput.selectable = true;	}	function deactivateMenu() :void	{		goBtn.removeEventListener( MouseEvent.CLICK, goBtnClicked );		searchInput.removeEventListener( KeyboardEvent.KEY_UP, inputKeyUp );		searchInput.selectable = false;		searchInput.setTextFormat( rightFormat );	}		function parseToHouse( userInput:String ) :String	{		trace( "parsedHouse: "+userInput.charAt(0) );		switch( userInput.charAt(0).toUpperCase() )		{			case 'D' : return "grashof";			case 'A' : return "beuth";			case 'B' : return "gauss";			case 'C' : return "bauwesen";			default  : return "ERROR no valid houseLetter :: "+userInput.charAt(0);		}	}	function parseToFloor( userInput:String ) :int	{		trace( "parsedFloor: "+userInput.charAt(1) );		switch( userInput.charAt(1) )		{			case '0' : return 1;			case '1' : return 2;			case '2' : return 3;			case '3' : return 4;			case '4' : return 5;			case '5' : return 6;			case '6' : return 7;			case '7' : return 8;			case '8' : return 9;			case '9' : return 10;			case '10' : return 11;			default  : return -1;		}	}	function parseToRoom( userInput:String ) :String	{		trace( "parsedRoom: "+userInput.substring( 1,4 ) );		return userInput.substring( 1,4 );	}}}